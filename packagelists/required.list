# Lareon OS: packages the image cannot work without. The build stops if any
# of these names is missing from Debian 13.

# Desktop (KDE Plasma 6)
plasma-desktop
plasma-workspace
kwin-wayland
sddm
plasma-nm
plasma-pa
powerdevil
kscreen
systemsettings
kinfocenter
breeze
xdg-desktop-portal-kde
polkit-kde-agent-1

# Everyday apps (re-themed KDE apps rather than custom ones)
dolphin
konsole
gwenview
okular
kcalc
ark

# Apps store
plasma-discover
flatpak
ca-certificates

# System
network-manager
sudo
# Debian live-config creates the live account through this package. It is only
# a "recommends", and the image is built without recommends, so it is listed here.
user-setup
locales
python3
tzdata
plymouth
# draws text on the boot screen (needed for the disk password prompt)
plymouth-label
fonts-dejavu-core
pipewire-pulse
wireplumber
fonts-noto-core

# Installer
calamares
calamares-settings-debian
# Boot loader for the installed system. The installer copies this image to the
# drive and then runs grub-install, so grub must be inside the image: the
# live disc's own boot files are made separately and are not copied over.
# (-bin packages, not grub-pc / grub-efi-amd64, which conflict with each other.)
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
dosfstools
e2fsprogs
# Tools the installer runs. The image is built without "recommends", so the
# ones Calamares only recommends are listed here: unsquashfs unpacks the system
# onto the drive (the install failed without it), the rest partition, format
# and encrypt the drive.
squashfs-tools
parted
rsync
cryptsetup
lvm2
btrfs-progs
xfsprogs

# Lareon screens (first-start setup, installer session, crash dialog, notifications)
python3-yaml
dbus-user-session
libnotify-bin
systemd-coredump
os-prober
kde-cli-tools
fonts-noto-color-emoji
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qml6-module-qtquick-templates
qml6-module-qtqml-workerscript
kdialog
