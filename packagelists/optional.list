# Lareon OS: nice-to-have packages. If a name isn't in Debian 13 the build
# drops it with a warning instead of failing.

# Desktop extras
sddm-theme-breeze
kde-config-sddm
kwin-x11
bluedevil
plasma-systemmonitor
kde-spectacle
kwrite
plasma-discover-backend-flatpak
kio-extras
kde-config-gtk-style
breeze-gtk-theme
xdg-user-dirs
plymouth-themes
pipewire-alsa
fonts-noto-color-emoji
# Chinese, Japanese and Korean text (3 of Lareon's 17 languages); Geist has no CJK
fonts-noto-cjk
fonts-hack

# Hardware support for real machines (Wi-Fi, graphics, sound, CPU fixes)
firmware-linux-free
firmware-misc-nonfree
firmware-amd-graphics
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-intel-sound
firmware-sof-signed
intel-microcode
amd64-microcode
bluez

# Virtual machines (screen resize and clipboard in virt-manager/GNOME Boxes)
spice-vdagent
papirus-icon-theme

# Boot on computers with Secure Boot on (installed system)
grub-efi-amd64-signed
shim-signed
mokutil

# Widget style (Kvantum, recoloured as Lareon)
qt6-style-kvantum
qt5-style-kvantum

# Start-up chime player
pipewire-bin
pulseaudio-utils

# Libraries the Ember and Lareon apps (Electron) need to start
libgtk-3-0t64
libnss3
libasound2t64
libgbm1
libxss1
libxtst6
libatspi2.0-0t64
libcups2t64
libdrm2
libxkbcommon0
libnotify4
libsecret-1-0
libxcomposite1
libxdamage1
libxrandr2
libpango-1.0-0
libcairo2
xdg-utils

xwayland
