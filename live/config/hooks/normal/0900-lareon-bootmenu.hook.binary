#!/bin/sh
# Lareon boot menu for the live USB (BIOS and UEFI both use GRUB here).
# Replaces live-build's menu with: Install Lareon OS (default, starts by itself
# after 8 seconds), Try Lareon OS without installing, Install with safe
# graphics, Firmware settings. The theme files are in boot/grub/lareon/
# (config/includes.binary, made by build.sh).
set -e
cfg=boot/grub/grub.cfg
[ -f "$cfg" ] || { echo "lareon bootmenu: $cfg not found" >&2; exit 1; }

# Reuse the kernel, initrd and options live-build worked out.
line=$(grep -h -m1 -E '^[[:space:]]*linux[[:space:]]' boot/grub/*.cfg | head -n1)
kernel=$(echo "$line" | awk '{print $2}')
options=$(echo "$line" | sed -E 's/^[[:space:]]*linux[[:space:]]+[^[:space:]]+[[:space:]]*//')
initrd=$(grep -h -m1 -E '^[[:space:]]*initrd[[:space:]]' boot/grub/*.cfg | head -n1 | awk '{print $2}')
[ -n "$kernel" ] && [ -n "$initrd" ] || { echo "lareon bootmenu: kernel/initrd not found in GRUB config" >&2; exit 1; }

# The live flags must come BEFORE the "--" separator: live-boot and live-config
# only read what is in front of it, and without boot=live the live system,
# its automatic sign-in and the installer never start.
# Split at the first "--" or "---" word (tokens, so a separator at the very end
# of the line works too).
pre=$(printf '%s\n' "$options" | awk '{for(i=1;i<=NF;i++){if($i=="--"||$i=="---")break; printf "%s%s",(i>1?" ":""),$i}}')
post=$(printf '%s\n' "$options" | awk '{f=0; o=""; for(i=1;i<=NF;i++){ if(f){o=o (o==""?"":" ") $i} else if($i=="--"||$i=="---"){f=1} } print o}')
case " $pre " in *" boot=live "*) ;; *) pre="boot=live $pre" ;; esac
case " $pre " in *" components "*|*" components="*) ;; *) pre="$pre components" ;; esac
case " $pre " in *" hostname="*) ;; *) pre="$pre hostname=lareon" ;; esac
case " $pre " in *" username="*|*" live-config.username="*) ;; *) pre="$pre username=lareon" ;; esac
pre=$(echo "$pre" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')
if [ -n "$post" ]; then tail_args=" -- $post"; else tail_args=""; fi
options="$pre"
echo "lareon bootmenu: kernel=$kernel initrd=$initrd options=$options$tail_args"

fonts=""
for f in boot/grub/lareon/*.pf2; do [ -f "$f" ] && fonts="$fonts
loadfont /$f"; done

cat > "$cfg" <<GRUB
# Lareon OS live USB boot menu (made by 0900-lareon-bootmenu.hook.binary)
set default=0
set timeout=8
set timeout_style=menu
insmod all_video
insmod gfxterm
insmod png
insmod font
$fonts
set gfxmode=auto
terminal_output gfxterm
insmod gfxmenu
insmod gfxterm_background
# find the disc by the theme file, so the paths below always resolve
search --no-floppy --file --set=root /boot/grub/lareon/theme.txt
if [ -f /boot/grub/lareon/theme.txt ]; then
    set theme=/boot/grub/lareon/theme.txt
    export theme
fi

menuentry "Install Lareon OS" --class lareon {
	linux $kernel $options lareon.mode=install$tail_args
	initrd $initrd
}
menuentry "Try Lareon OS without installing" --class lareon {
	linux $kernel $options lareon.mode=try$tail_args
	initrd $initrd
}
menuentry "Install with safe graphics" --class lareon {
	linux $kernel $options nomodeset lareon.mode=install$tail_args
	initrd $initrd
}
menuentry "Text console (for troubleshooting)" --class settings {
	linux $kernel $options systemd.unit=multi-user.target lareon.mode=try$tail_args
	initrd $initrd
}
if [ "\$grub_platform" = "efi" ]; then
	menuentry "Firmware settings" --class settings {
		fwsetup
	}
fi
GRUB
if command -v grub-script-check >/dev/null 2>&1; then
    grub-script-check "$cfg"
fi
