#!/bin/sh
set -e
if [ "$1" = configure ]; then
    systemctl --global enable lareon-timeofday.timer >/dev/null 2>&1 || true
    systemctl enable lareon-timeofday-link.timer >/dev/null 2>&1 || true
    /usr/bin/lareon-timeofday update-link || true
    if [ -d /run/systemd/system ]; then
        systemctl start lareon-timeofday-link.timer >/dev/null 2>&1 || true
    fi
fi
exit 0
