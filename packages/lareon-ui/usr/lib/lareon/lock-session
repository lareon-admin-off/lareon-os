#!/bin/sh
# "Lock" shows the Lareon sign-in screen (the same one you see at startup).
# Your session keeps running behind it; sign back in to return.
seat="${XDG_SEAT_PATH:-/org/freedesktop/DisplayManager/Seat0}"
busctl --system call org.freedesktop.DisplayManager "$seat" \
    org.freedesktop.DisplayManager.Seat SwitchToGreeter >/dev/null 2>&1 && exit 0
exec loginctl lock-session
