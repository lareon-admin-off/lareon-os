/* Lareon installer styling. Window colours come from the Lareon Dark colour
   scheme (the installer runs as root, which uses the system defaults). */

* {
    font-family: "Geist";
}

QPushButton {
    background-color: #211e2d;
    color: #ece9f5;
    border: 1px solid #2b2838;
    border-radius: 8px;
    padding: 7px 18px;
}
QPushButton:hover {
    border-color: #a35cf5;
}
QPushButton:disabled {
    color: #74718a;
}

/* "Next" / "Install" */
#view-button-next {
    background-color: #ff7c1f;
    color: #13111b;
    border: none;
    font-weight: 600;
}
#view-button-next:hover {
    background-color: #ff8f3d;
}
#view-button-next:disabled {
    background-color: #2b2838;
    color: #74718a;
}

QProgressBar {
    background-color: #2b2838;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff7c1f, stop:0.6 #d94fc4, stop:1 #a35cf5);
}
