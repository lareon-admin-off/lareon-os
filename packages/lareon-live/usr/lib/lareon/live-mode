#!/bin/sh
# Live USB: choose what the automatic sign-in opens.
#   live-mode            read lareon.mode= from the boot menu choice (default: try)
#   live-mode install    full-screen installer only, no desktop
#   live-mode try        the live desktop
#   ... --restart        apply now (restarts the sign-in screen)
set -e
mode="${1:-}"
if [ -z "$mode" ] || [ "$mode" = "--restart" ]; then
    mode=try
    for arg in $(cat /proc/cmdline); do
        case "$arg" in lareon.mode=*) mode="${arg#lareon.mode=}" ;; esac
    done
fi
user=lareon
for arg in $(cat /proc/cmdline); do
    case "$arg" in username=*|live-config.username=*) user="${arg#*=}" ;; esac
done
# Safety net: Debian's live-config normally creates the live account. If it did
# not (for example because its user-setup package is missing), create it here,
# with the same groups and password-less sudo, so the automatic sign-in and the
# installer (which runs through sudo) always work. Live session only: this
# changes the running live system, never the image the installer copies.
if ! getent passwd "$user" >/dev/null 2>&1; then
    groups=""
    for g in sudo audio video cdrom plugdev netdev users render input; do
        getent group "$g" >/dev/null 2>&1 && groups="$groups,$g"
    done
    useradd --create-home --shell /bin/bash --comment "Lareon live session" \
        ${groups:+--groups "${groups#,}"} "$user" 2>/dev/null || true
    mkdir -p /etc/sudoers.d
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > /etc/sudoers.d/lareon-live
    chmod 0440 /etc/sudoers.d/lareon-live
    visudo -cf /etc/sudoers.d/lareon-live >/dev/null 2>&1 || rm -f /etc/sudoers.d/lareon-live
fi
# Live session only (this service runs only when booted with boot=live): give
# the live account the well-known live password, so a text console or the login
# screen always works when something else goes wrong. The installed system
# gets its own account from the installer; this one is removed there.
if [ -z "$LAREON_NO_PASSWD" ] && getent passwd "$user" >/dev/null 2>&1; then
    echo "$user:live" | chpasswd 2>/dev/null || true
    usermod -U "$user" 2>/dev/null || true
    chage -E -1 -M -1 "$user" 2>/dev/null || true
    # the installer runs through sudo -n, so password-less sudo must exist
    if [ ! -f /etc/sudoers.d/lareon-live ]; then
        mkdir -p /etc/sudoers.d
        printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > /etc/sudoers.d/lareon-live
        chmod 0440 /etc/sudoers.d/lareon-live
        visudo -cf /etc/sudoers.d/lareon-live >/dev/null 2>&1 || rm -f /etc/sudoers.d/lareon-live
    fi
fi
# In a virtual machine there is no graphics card, so the desktop's blur and
# fade effects are drawn by the CPU and feel slow. Turn them off there (live
# session only; the installed system makes its own choice).
if [ -n "$(getent passwd "$user" | cut -d: -f6)" ] && command -v systemd-detect-virt >/dev/null 2>&1 \
   && systemd-detect-virt --quiet 2>/dev/null; then
    vhome=$(getent passwd "$user" | cut -d: -f6)
    if [ -d "$vhome" ] && [ ! -e "$vhome/.config/kwinrc" ]; then
        mkdir -p "$vhome/.config"
        cat > "$vhome/.config/kwinrc" <<'KWIN'
[Plugins]
blurEnabled=false
contrastEnabled=false
slidingpopupsEnabled=false
KWIN
        chown -R "$user:" "$vhome/.config" 2>/dev/null || true
    fi
fi
# Desktop icon: Debian's "Install Debian" goes, ours stays.
home=$(getent passwd "$user" | cut -d: -f6)
if [ -n "$home" ] && [ -d "$home" ] && [ "$mode" != install ] && [ "$mode" != choose ]; then
    mkdir -p "$home/Desktop"
    for f in "$home"/Desktop/*; do
        [ -f "$f" ] || continue
        case "$(basename "$f")" in
            *ebian*|*alamares*|*nstall*) rm -f "$f" ;;
        esac
    done
    if [ -f /usr/share/applications/lareon-install.desktop ]; then
        cp /usr/share/applications/lareon-install.desktop "$home/Desktop/Install Lareon OS.desktop"
        chmod +x "$home/Desktop/Install Lareon OS.desktop"
    fi
    chown -R "$user:" "$home/Desktop" 2>/dev/null || true
fi
case "$mode" in
    install|choose) session=lareon-installer.desktop ;;
    *)       session=plasma.desktop ;;
esac

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-lareon-live.conf <<CONF
[Autologin]
User=$user
Session=$session
Relogin=true
CONF
# /etc/sddm.conf (if live-config wrote one) would win over sddm.conf.d, so
# take the automatic sign-in settings out of it.
if [ -f /etc/sddm.conf ]; then
    sed -i -e '/^User=/d' -e '/^Session=/d' /etc/sddm.conf
fi

case " $* " in *" --restart "*) systemctl restart display-manager.service ;; esac
