#!/bin/sh
# Live USB "Install Lareon OS": KWin running only the installer, full screen.
export QT_QUICK_CONTROLS_STYLE=Basic
kwin_wayland --locale1 --no-lockscreen --no-global-shortcuts \
    --exit-with-session=/usr/lib/lareon/installer-run
# The installer was closed without installing: open the live desktop instead.
exec sudo -n /usr/lib/lareon/live-mode try --restart
