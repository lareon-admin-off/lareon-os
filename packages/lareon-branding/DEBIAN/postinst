#!/bin/sh
# Debian's base-files owns these files and would put "Debian" back on every
# upgrade. dpkg-divert moves Debian's copies aside permanently, so upgrades
# write to the .debian names and ours stay in place.
set -e
divert() {
    dpkg-divert --package lareon-branding --add --rename \
        --divert "$1.debian" "$1" >/dev/null
    cp "/usr/share/lareon/$2" "$1"
}
if [ "$1" = configure ]; then
    divert /usr/lib/os-release os-release
    divert /etc/issue issue
    divert /etc/issue.net issue.net
    # Lareon boot screen (the initramfs is rebuilt by the trigger in DEBIAN/triggers)
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme lareon || true
    fi
    # Boot menu: tell it each start that finished (see /etc/grub.d/05_lareon)
    systemctl enable lareon-boot-ok.service >/dev/null 2>&1 || true
    # Network: NetworkManager must be on in the installed system
    systemctl enable NetworkManager.service >/dev/null 2>&1 || true
    if [ -x /usr/sbin/update-grub ] && [ -e /boot/grub/grub.cfg ]; then
        update-grub >/dev/null 2>&1 || true
    fi
fi
exit 0
