#!/bin/sh
set -e
undivert() {
    rm -f "$1"
    dpkg-divert --package lareon-branding --remove --rename \
        --divert "$1.debian" "$1" >/dev/null
}
if [ "$1" = remove ] || [ "$1" = purge ]; then
    undivert /usr/lib/os-release
    undivert /etc/issue
    undivert /etc/issue.net
    if command -v plymouth-set-default-theme >/dev/null 2>&1 \
       && [ "$(plymouth-set-default-theme)" = lareon ]; then
        plymouth-set-default-theme --reset || true
    fi
fi
exit 0
