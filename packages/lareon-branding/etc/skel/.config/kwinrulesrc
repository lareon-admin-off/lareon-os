[General]
count=3
rules=lareon-home,lareon-app,ember-app

[lareon-home]
Description=Lareon Home sits next to the dock
above=true
aboverule=2
noborder=true
noborderrule=2
position=96,52
positionrule=2
skiptaskbar=true
skiptaskbarrule=2
skipswitcher=true
skipswitcherrule=2
title=Lareon Home
titlematch=1
wmclass=lareon-ui
wmclasscomplete=false
wmclassmatch=1

[lareon-app]
Description=The Lareon app uses the Lareon launcher icon in the dock
desktopfile=lareon.desktop
desktopfilerule=2
wmclass=(^|\\s)lareon(\\s|$)
wmclasscomplete=false
wmclassmatch=3

[ember-app]
Description=Ember uses the Ember launcher icon in the dock
desktopfile=ember.desktop
desktopfilerule=2
wmclass=(^|\\s)ember(\\s|$)
wmclasscomplete=false
wmclassmatch=3
