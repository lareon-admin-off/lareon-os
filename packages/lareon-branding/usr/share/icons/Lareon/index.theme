[Icon Theme]
Name=Lareon
Comment=Lareon folders and app icons on top of Papirus
Inherits=Papirus-Dark,breeze-dark,breeze,hicolor
Directories=scalable/places,scalable/apps,scalable/mimetypes,scalable/devices

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/devices]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices
